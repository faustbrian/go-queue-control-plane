        "responsibility": "Provide an authenticated administrative control plane for durable queue commands, desired state, audit history, fleet visibility, and optional Kubernetes workload scaling.",
        "non_goals": [
          "Deliver, acknowledge, retry, reclaim, or serialize queue messages, or replace the queue data plane.",
          "Issue raw Redis or Valkey commands, supervise worker processes, or hide backend-specific capability negotiation.",
          "Own caller-provided PostgreSQL pools, queue controllers, Kubernetes clients, HTTP clients, or application lifecycle orchestration."
        ],
        "public_package_identifier": "controlplane",
        "primary_entry_packages": [
          "github.com/faustbrian/go-queue-control-plane"
        ],
        "package_selection": {
          "github.com/faustbrian/go-queue-control-plane": "Use for stable administrative command, result, permission, target, and validation contracts.",
          "github.com/faustbrian/go-queue-control-plane/alerts": "Use to derive bounded control-plane alerts and fixed-label telemetry from validated snapshots.",
          "github.com/faustbrian/go-queue-control-plane/apihttp": "Use for the authenticated versioned administrative HTTP API, admission controls, and response protections.",
          "github.com/faustbrian/go-queue-control-plane/authz": "Use to translate authenticated principals into exact authorization requests.",
          "github.com/faustbrian/go-queue-control-plane/cli": "Use to embed the administrative command-line workflow against a typed control-plane client.",
          "github.com/faustbrian/go-queue-control-plane/client": "Use for bounded typed access to a deployed control-plane HTTP API.",
          "github.com/faustbrian/go-queue-control-plane/control": "Use to orchestrate authorization, durable idempotency, audit persistence, dispatch, and terminal outcomes.",
          "github.com/faustbrian/go-queue-control-plane/dataplane": "Use to adapt tenant-resolved queue management contracts to control-plane commands and views.",
          "github.com/faustbrian/go-queue-control-plane/fleet": "Use for bounded in-memory worker registration, protocol negotiation, and fleet projection.",
          "github.com/faustbrian/go-queue-control-plane/history": "Use for tamper-evident tenant audit events, chain verification, and retention anchors.",
          "github.com/faustbrian/go-queue-control-plane/kubernetes": "Use for explicitly configured namespace-scoped Kubernetes Deployment status and scale operations.",
          "github.com/faustbrian/go-queue-control-plane/postgres": "Use for embedded migrations and durable PostgreSQL command, desired-state, and audit repositories.",
          "github.com/faustbrian/go-queue-control-plane/server": "Use to compose static access control and run the bounded administrative HTTP lifecycle.",
          "github.com/faustbrian/go-queue-control-plane/ui": "Use for the embedded read-only administrative web interface."
        },
